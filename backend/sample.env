# VaultX Backend Environment Configuration

# --- Application ---
APP_ENV=dev
PASSWORD_AUTH_MODE=legacy-bcrypt
# Set opaque-required only after an approved PAKE/OPAQUE implementation is deployed.
APP_SECRET_KEY=change_me_to_a_strong_random_secret_key_32chars_min
JWT_SECRET_KEY=change_me_jwt_secret_key_min_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vaultx
# The API runtime role must not be a superuser or have BYPASSRLS.
DB_USER=vaultx_runtime
DB_PASSWORD=change_me_runtime_password
# Used only by the migration job / database owner, never by the API process.
DB_MIGRATION_USER=vaultx_migration
DB_MIGRATION_PASSWORD=change_me_migration_password
DB_RUNTIME_USER=vaultx_runtime
DB_RUNTIME_PASSWORD=change_me_runtime_password

# --- Mail ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply
MAIL_PASSWORD=change_me
MAIL_FROM="VaultX <noreply@vaultx.in>"
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- Key Storage ---
KEYS_DIR=.secret/keys
FALLBACK_KEYS_DIR=.secret/keys_fallback

# --- Bootstrap local admin (optional, for dev/demo work) ---
# Set both values to create a preconfigured admin account once at startup.
# Existing accounts and vault keys are never modified by startup bootstrap.
#BOOTSTRAP_ADMIN_EMAIL=admin@vaultx.local
#BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrongPassword123!

# --- Rate Limiting ---
RATE_LIMIT_RATE=100
RATE_LIMIT_CAPACITY=200
